{
  // Default cloud-only OpenCode configuration.
  // Swap model IDs below to match your preferred provider (Anthropic, OpenAI, Google, or GitHub Copilot).
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "instructions": [
    "~/.config/opencode/instructions/workflow-policy.md"
  ],
  "plugins": [
    "github:AxeForce/opencode-vibeguard-v2",
    "@tarquinen/opencode-dcp@3.2.0",
    "github:oakwood-commons/spiral-guard#v2"
  ],
  "agents": {
    // Stronger reasoning model for planning, architecture, and adversarial review
    "plan": { "model": "anthropic/claude-opus-4-5" },
    "planner": { "model": "anthropic/claude-opus-4-5" },
    "code-reviewer": { "model": "anthropic/claude-opus-4-5" },
    "pr-reviewer": { "model": "anthropic/claude-opus-4-5" },
    // Cross-family reviewer to break stuck PR review loops
    "review-buster": { "model": "openai/gpt-5" },
    // Fast, capable workhorse model for bounded implementation, audits, and git hygiene
    "build": { "model": "anthropic/claude-sonnet-4-5" },
    "general": { "model": "anthropic/claude-sonnet-4-5" },
    "go-tester": { "model": "anthropic/claude-sonnet-4-5" },
    "artifact-auditor": { "model": "anthropic/claude-sonnet-4-5" },
    "docs-writer": { "model": "anthropic/claude-sonnet-4-5" },
    "pr-create": { "model": "anthropic/claude-sonnet-4-5" },
    // Lightweight model for quick search, titles, and context compaction
    "explore": { "model": "anthropic/claude-haiku-4-5" },
    "title": { "model": "anthropic/claude-haiku-4-5" },
    "compaction": { "model": "anthropic/claude-haiku-4-5" }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git add*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git commit *--amend*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git tag*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh release*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "scafctl": {
        "type": "local",
        "command": ["scafctl", "mcp", "serve"]
      }
    }
  }
}
