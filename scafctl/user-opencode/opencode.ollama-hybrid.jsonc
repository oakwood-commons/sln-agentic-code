{
  // Optional hybrid configuration: local GPU Ollama workhorse + cloud frontier escalation.
  // Use this template if you run local coding models via Ollama and want $0 routine loops
  // while keeping frontier cloud reasoning for planning, security review, and 2-strike escalations.
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (Local)",
          "capabilities": { "tools": true, "reasoning": { "supported": false } },
          "limit": { "context": 64000, "output": 8192 }
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B Utility (Local)",
          "capabilities": { "tools": true, "reasoning": { "supported": false } },
          "limit": { "context": 64000, "output": 8192 }
        }
      }
    }
  },
  "model": "ollama/qwen3-coder:30b",
  "instructions": [
    "~/.config/opencode/instructions/workflow-policy.md"
  ],
  "plugins": [
    "github:AxeForce/opencode-vibeguard-v2",
    "@tarquinen/opencode-dcp@3.2.0",
    "github:oakwood-commons/spiral-guard#v2"
  ],
  "agents": {
    // Cloud frontier models for up-front design, review, and loop-breaking
    "plan": { "model": "anthropic/claude-opus-4-5" },
    "planner": { "model": "anthropic/claude-opus-4-5" },
    "code-reviewer": { "model": "anthropic/claude-opus-4-5" },
    "pr-reviewer": { "model": "anthropic/claude-opus-4-5" },
    "review-buster": { "model": "openai/gpt-5" },
    // Local GPU workhorse for everyday TDD implementation and checks
    "build": { "model": "ollama/qwen3-coder:30b" },
    "general": { "model": "ollama/qwen3-coder:30b" },
    "go-tester": { "model": "ollama/qwen3-coder:30b" },
    "artifact-auditor": { "model": "ollama/qwen3-coder:30b" },
    "docs-writer": { "model": "ollama/qwen3-coder:30b" },
    "pr-create": { "model": "ollama/qwen3-coder:30b" },
    "explore": { "model": "ollama/qwen3.5:9b" },
    "title": { "model": "ollama/qwen3.5:9b" },
    "compaction": { "model": "ollama/qwen3.5:9b" }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git add*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git commit *--amend*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git tag*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh release*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "scafctl": {
        "type": "local",
        "command": ["scafctl", "mcp", "serve"]
      }
    }
  }
}
